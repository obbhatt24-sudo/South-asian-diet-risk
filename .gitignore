node_modules/
.DS_Store
*.pyc
__pycache__/

# Server: only track source files; never commit .env or anything with the API key
server/*
!server/main.py
!server/retriever.py
!server/requirements.txt
!server/.env.example
!server/build_embeddings.py
!server/render.yaml
.env

# embeddings.json is committed so Render has it at build time (small, ~350KB)
ml/nhanes_data/
ml/.ipynb_checkpoints/
ml/*.pkl

# Migration script holds the Supabase SERVICE ROLE key when run — never commit
scripts/migrate-to-supabase.js
